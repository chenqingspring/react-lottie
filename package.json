{
  "name": "react-lottie",
  "version": "2.5.2",
  "funding": "https://opencollective.com/react-lottie",
  "description": "lottie animation view for React",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenqingspring/react-lottie.git"
  },
  "license": "MIT",
  "scripts": {
    "release": "git add package.json && git commit -m 'chore: bump version number' && standard-version --first-release && git push --follow-tags origin master && npm publish",
    "postinstall": "node scripts/postinstall.js",
    "prepublish": ". ./.scripts/prepublish.sh",
    "lint": "eslint src",
    "lintfix": "eslint src --fix",
    "testonly": "mocha --require .scripts/mocha_runner.js src/**/tests/**/*.js",
    "test": "npm run lint && npm run testonly",
    "test-watch": "npm run testonly -- --watch --watch-extensions js",
    "start": "storybook dev -p 9010",
    "build-storybook": "storybook build -o .out",
    "publish-storybook": "bash .scripts/publish_storybook.sh",
    "postpublish": "npm run publish-storybook"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@eslint/js": "^9.39.5",
    "@storybook/react-vite": "^10.6.5",
    "chai": "^4.5.0",
    "enzyme": "^3.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^22.1.0",
    "standard-version": "^9.5.0",
    "storybook": "^10.6.5",
    "vite": "^7.3.7"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "minimatch@^10.2.2": "11.0.4"
  },
  "resolutions": {
    "cheerio": "1.0.0-rc.12"
  },
  "dependencies": {
    "lottie-web": "^5.12.2",
    "prop-types": "^15.8.1"
  },
  "main": "dist/index.js"
}
